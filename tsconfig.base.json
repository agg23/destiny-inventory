{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "composite": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "app/store/types": ["packages/dim-bridge/src/shims/store-types.ts"],
      "app/i18next-t": ["packages/dim-bridge/src/shims/i18next-t.ts"],
      "app/i18n": ["packages/dim-bridge/src/shims/i18n.ts"],
      "app/utils/sentry": ["packages/dim-bridge/src/shims/sentry.ts"],
      "app/utils/log": ["packages/dim-bridge/src/shims/log.ts"],
      "app/dim-ui/BungieImage": ["packages/dim-bridge/src/shims/bungie-image.ts"],
      "app/records/collectible-matching": [
        "packages/dim-bridge/src/shims/collectible-matching.ts"
      ],
      "@sentry/browser": ["packages/dim-bridge/src/shims/sentry-sdk.ts"],
      "@sentry/react": ["packages/dim-bridge/src/shims/sentry-sdk.ts"],
      "app/*": ["vendor/DIM/src/app/*"],
      "data/*": ["vendor/DIM/src/data/*"],
      "@dvm/*": ["packages/*/src"]
    }
  }
}
