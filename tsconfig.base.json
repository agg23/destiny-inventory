{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "composite": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "app/store/types": ["packages/dim-bridge/src/shims/store-types.ts"],
      "app/store/store": ["packages/dim-bridge/src/shims/store.ts"],
      "app/inventory/selectors": ["packages/dim-bridge/src/shims/inventory-selectors.ts"],
      "app/inventory/cross-tab": ["packages/dim-bridge/src/shims/cross-tab.ts"],
      "app/inventory/dim-item-info": ["packages/dim-bridge/src/shims/dim-item-info.ts"],
      "app/loadout/selectors": ["packages/dim-bridge/src/shims/loadout-selectors.ts"],
      "app/accounts/actions": ["packages/dim-bridge/src/shims/accounts-actions.ts"],
      "app/accounts/reducer": ["packages/dim-bridge/src/shims/accounts-reducer.ts"],
      "app/accounts/destiny-account": ["packages/dim-bridge/src/shims/destiny-account.ts"],
      "app/bungie-api/destiny1-api": ["packages/dim-bridge/src/shims/destiny1-api.ts"],
      "app/bungie-api/destiny2-api": ["packages/dim-bridge/src/shims/destiny2-api.ts"],
      "testing/*": ["packages/move-tests/src/*"],
      "app/i18next-t": ["packages/dim-bridge/src/shims/i18next-t.ts"],
      "app/i18n": ["packages/dim-bridge/src/shims/i18n.ts"],
      "app/utils/sentry": ["packages/dim-bridge/src/shims/sentry.ts"],
      "app/utils/log": ["packages/dim-bridge/src/shims/log.ts"],
      "app/dim-ui/BungieImage": ["packages/dim-bridge/src/shims/bungie-image.ts"],
      "app/records/collectible-matching": [
        "packages/dim-bridge/src/shims/collectible-matching.ts"
      ],
      "@sentry/browser": ["packages/dim-bridge/src/shims/sentry-sdk.ts"],
      "@sentry/react": ["packages/dim-bridge/src/shims/sentry-sdk.ts"],
      "app/*": ["vendor/DIM/src/app/*"],
      "data/*": ["vendor/DIM/src/data/*"],
      "@dvm/*": ["packages/*/src"]
    }
  }
}
